{
  "name": "chonk-doom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CHONK DOOM - a retro browser FPS where you play Le Chonk, and a harness that lets Mistral Large 4 play it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/bench.mjs",
    "eval": "evalite run --threshold 0 --outputPath evals/results/latest.json && node evals/summarize.mjs",
    "eval:watch": "evalite watch",
    "eval:data": "node evals/make-dataset.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.1",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "evalite": "^0.19.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
